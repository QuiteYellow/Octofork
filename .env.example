# Copy to .env and fill in. .env is gitignored -- never commit real values.
#
#   cp .env.example .env

# Your Apple Developer Team ID.
# Find it with:  security find-identity -v -p codesigning
# (the 10-character code in parentheses), or at
# https://developer.apple.com/account -> Membership details.
OCTOFORK_DEVELOPMENT_TEAM=XXXXXXXXXX

# Reverse-DNS bundle identifier for your build. Must differ from upstream's
# com.leddytech.octonaut so this installs alongside the TestFlight build
# instead of replacing it.
OCTOFORK_BUNDLE_ID=com.example.octofork

# The prefix portion of the above, used for auxiliary targets.
OCTOFORK_BUNDLE_PREFIX=com.example

# Home screen name. Keep it distinct from "Octonaut" so you can tell the two
# apps apart on the device. Quote it if it contains spaces -- this file is
# sourced by the shell.
OCTOFORK_DISPLAY_NAME=Octofork

# Custom URL scheme. Upstream registers "octonaut"; if both apps claim the
# same scheme, iOS picks one arbitrarily and reddit links may open the wrong
# app. Keep this unique to your build.
OCTOFORK_URL_SCHEME=octofork

# Name of the generated Xcode project (produces <name>.xcodeproj). Kept
# separate from upstream's Octonaut.xcodeproj so the tracked project file is
# never rewritten by a fork build.
OCTOFORK_PROJECT_NAME=Octofork

# Optional: build a local add-in into this variant. Leave both unset for an
# ordinary build -- an unset value reads as "off", and the generated project
# is then exactly what it is without them.
#
# Set these only in a variant's own env file (e.g. .env.alt), never in .env.
# The add-in lives in its own repository and nothing about it is tracked here;
# if you did not set this up, you do not need it.
# OCTOFORK_DEV_ADDIN=true
#
# Absolute path to that repository's checkout.
# OCTOFORK_DEV_ADDIN_PATH=/absolute/path/to/checkout
